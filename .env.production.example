# Production Environment Variables
# Copy values from PRODUCTION_SETUP.md guide

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# NextAuth Configuration (NEXTAUTH_URL — без "/" у кінці)
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="GENERATE_WITH_openssl_rand_hex_32"

# Google OAuth (from console.cloud.google.com)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID_HERE"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET_HERE"

# Rate limiting (Upstash Redis) — optional; без них працює лімітер у пам'яті.
# Або пара KV_REST_API_URL / KV_REST_API_TOKEN з інтеграції Upstash у Vercel.
UPSTASH_REDIS_REST_URL="https://YOUR_DB.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_TOKEN_HERE"

# Payments — вимкнено, поки не встановлено "true" (тоді потрібні ключі Stripe нижче)
# NEXT_PUBLIC_PAYMENTS_ENABLED="true"

# Stripe Live Keys (from dashboard.stripe.com) — лише з увімкненими платежами
STRIPE_SECRET_KEY="sk_live_YOUR_KEY_HERE"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_YOUR_KEY_HERE"
STRIPE_WEBHOOK_SECRET="whsec_YOUR_SIGNING_SECRET_HERE"
